<UserControl x:Class="UI.Controls.RoundedImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="100"
             x:Name="Root">

    <Border x:Name="ImageBorder"
            Width="{Binding ImageWidth, ElementName=Root}"
            Height="{Binding ImageHeight, ElementName=Root}"
            ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource CardBackgroundColor}"/>
        </Border.Background>
        <Image local:ImageEx.SourceUrl="{Binding SourceUrl, ElementName=Root}"
               Stretch="UniformToFill"
               RenderOptions.BitmapScalingMode="HighQuality"/>
    </Border>
</UserControl>