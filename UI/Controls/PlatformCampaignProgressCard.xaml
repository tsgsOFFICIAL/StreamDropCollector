<UserControl x:Class="UI.Controls.PlatformCampaignProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UI"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">

    <UserControl.Resources>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Border HorizontalAlignment="Left" CornerRadius="5" Background="{TemplateBinding Foreground}">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource PercentToWidthConverter}">
                                        <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}"/>
                                        <Binding Path="ActualWidth" ElementName="Root"/>
                                    </MultiBinding>
                                </Border.Width>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackgroundBrush}"
            Padding="20"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16">
                <Run Text="{Binding PlatformName, Mode=OneWay}"/>
                <Run Text=" Campaign Progress"/>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding CampaignName, Converter={StaticResource StringToVisibilityConverter}}">
                <Border Width="32" Height="42" CornerRadius="4" ClipToBounds="True"
                        Background="{DynamicResource MainBackgroundBrush}" Margin="0,0,8,0"
                        Visibility="{Binding CampaignImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                    <Image local:ImageEx.SourceUrl="{Binding CampaignImageUrl}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Campaign: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Run Text="{Binding CampaignName, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{Binding BrandBrushKey, Mode=OneWay, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                </TextBlock>
            </StackPanel>

            <ProgressBar Margin="0,10,0,5" Minimum="0" Maximum="100"
                         Value="{Binding CampaignProgress}"/>

            <TextBlock Text="{Binding CampaignProgress, StringFormat='{}{0}% Complete'}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>

            <TextBlock Text="Drop Progress" Margin="0,10,0,0"
                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"/>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                        Visibility="{Binding DropName, Converter={StaticResource StringToVisibilityConverter}}">
                <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True"
                        Background="{DynamicResource MainBackgroundBrush}" Margin="0,0,8,0"
                        Visibility="{Binding DropImageUrl, Converter={StaticResource StringToVisibilityConverter}}">
                    <Image local:ImageEx.SourceUrl="{Binding DropImageUrl}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="Item: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Run Text="{Binding DropName, Mode=OneWay}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                </TextBlock>
            </StackPanel>

            <ProgressBar Margin="0,10,0,5" Minimum="0" Maximum="100"
                         Value="{Binding DropProgress}"/>

            <TextBlock Text="{Binding DropProgress, StringFormat='{}{0}% Complete'}"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>

            <TextBlock Margin="0,5,0,0"
                       Visibility="{Binding WatchedChannel, Converter={StaticResource StringToVisibilityConverter}}">
                <Run Text="Watching: " Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Run Text="{Binding WatchedChannel, Mode=OneWay}" FontWeight="SemiBold"
                     Foreground="{Binding BrandBrushKey, Mode=OneWay, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>