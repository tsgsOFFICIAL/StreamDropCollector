<UserControl x:Class="UI.Controls.PlatformConnectionRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="20" d:DesignWidth="300">

    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Ellipse Width="10" Height="10"
                 Fill="{Binding ConnectionColor, FallbackValue=Red}"
                 VerticalAlignment="Center"/>
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center">
            <Run Text="{Binding PlatformName, Mode=OneWay}" FontWeight="Bold"
                 Foreground="{Binding BrandBrushKey, Mode=OneWay, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
            <Run Text=" : " Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Run Text="{Binding ConnectionStatus, Mode=OneWay, FallbackValue=Disconnected}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"/>
        </TextBlock>
    </StackPanel>
</UserControl>