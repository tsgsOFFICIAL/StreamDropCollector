<UserControl x:Class="UI.Controls.MinerStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="120" d:DesignWidth="280"
             x:Name="Root">

    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <TextBlock Text="Miner Status"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="16"/>
            <TextBlock Text="{Binding Status, ElementName=Root, FallbackValue=Active}"
                       Foreground="{Binding StatusBrush, ElementName=Root}"
                       FontSize="28"
                       Margin="0,10,0,0"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Details, ElementName=Root, FallbackValue=Waiting...}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"/>
        </StackPanel>
    </Border>
</UserControl>