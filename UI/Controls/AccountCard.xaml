<UserControl x:Class="UI.Controls.AccountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="560">
    <StackPanel Margin="0,0,0,16">
        <Border Background="{DynamicResource CardBackgroundBrush}"
                Padding="20,14"
                CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding Connection.ConnectionColor, FallbackValue=Red}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16">
                        <Run Text="{Binding PlatformName, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{Binding BrandBrushKey, Mode=OneWay, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                        <Run Text=" &#x2022; " Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Run Text="{Binding CustomSettingsLabel, Mode=OneWay}" FontSize="12"
                             Foreground="{DynamicResource AccentBrush}"/>
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{Binding Connection.ConnectionStatus, Mode=OneWay}"/>
                        <Run Text=" &#x2022; "/>
                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <Border Margin="20,8,0,0" HorizontalAlignment="Left"
                        Padding="10,3" CornerRadius="10"
                        Background="{DynamicResource InsetBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        ToolTip="Live rate (last ~10 s), average and total downloaded since the last reset"
                        Visibility="{Binding HasNetworkUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#x2193;" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding NetworkLiveText, Mode=OneWay}" Margin="5,0,0,0" FontSize="12"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <Rectangle Width="1" Height="12" Margin="10,0" Fill="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="avg" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding NetworkAverageText, Mode=OneWay}" Margin="5,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Rectangle Width="1" Height="12" Margin="10,0" Fill="{DynamicResource BorderBrush}"/>
                        <TextBlock Text="total" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding NetworkTotalText, Mode=OneWay}" Margin="5,0,0,0" FontSize="12"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Text="shared profile" Margin="10,0,0,0" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"
                                   ToolTip="This account shares one browser profile (and one meter) with another account"
                                   Visibility="{Binding IsNetworkSharedProfile, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Content="&#x21BB;" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,-6,0" Width="22" Height="20" Padding="0" FontSize="12" VerticalAlignment="Center"
                                ToolTip="Reset the totals and the average"
                                Click="OnResetNetworkClick"/>
                    </StackPanel>
                </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Content="Enabled" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <controls:PlatformLoginButton DataContext="{Binding Connection}"
                                                  LoginClick="OnLoginClick" Margin="0,0,8,0"/>
                    <Button Content="Settings" Style="{StaticResource SecondaryButtonStyle}"
                            Width="80" Height="36" Padding="0" Margin="0,0,8,0" Click="OnSettingsClick"/>
                    <Button Content="Remove" Style="{StaticResource DangerButtonStyle}"
                            Width="80" Height="36" Padding="0" Click="OnRemoveClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <controls:PlatformCampaignProgressCard DataContext="{Binding Progress}"/>
    </StackPanel>
</UserControl>