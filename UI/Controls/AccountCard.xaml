<UserControl x:Class="UI.Controls.AccountCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="560">
    <StackPanel Margin="0,0,0,16">
        <Border Background="{DynamicResource CardBackgroundBrush}"
                Padding="20,14"
                CornerRadius="8,8,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,1,1,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{Binding Connection.ConnectionColor, FallbackValue=Red}"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16">
                        <Run Text="{Binding PlatformName, Mode=OneWay}" FontWeight="Bold"
                             Foreground="{Binding BrandBrushKey, Mode=OneWay, Converter={StaticResource ResourceKeyToBrushConverter}}"/>
                        <Run Text=" &#x2022; " Foreground="{DynamicResource TextMutedBrush}"/>
                        <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="{Binding Connection.ConnectionStatus, Mode=OneWay}"/>
                        <Run Text=" &#x2022; "/>
                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              Content="Enabled" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <controls:PlatformLoginButton DataContext="{Binding Connection}"
                                                  LoginClick="OnLoginClick" Margin="0,0,8,0"/>
                    <Button Content="Remove" Width="80" Height="36" Click="OnRemoveClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <controls:PlatformCampaignProgressCard DataContext="{Binding Progress}"/>
    </StackPanel>
</UserControl>