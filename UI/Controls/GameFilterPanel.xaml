<UserControl x:Class="UI.Controls.GameFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="600"
             x:Name="Root">

    <StackPanel>
        <TextBlock Text="{Binding PlatformTitle, ElementName=Root}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <TextBlock Text="{Binding WhitelistSummary, ElementName=Root}"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="SearchBox"
                 Style="{StaticResource PlaceholderSearchTextBoxStyle}"
                 Tag="Search games…"
                 Margin="0,0,0,6"
                 TextChanged="OnSearchTextChanged"/>
        <Border Style="{StaticResource InsetPanelBorder}" Margin="0,0,0,6">
            <ListBox x:Name="OptionsList"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="140">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Margin="0,4,0,4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel x:Name="PriorityPanel" Margin="0,0,0,8">
            <TextBlock Text="Mining priority: top game is mined first, later games only when it has nothing to mine."
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource InsetPanelBorder}">
                    <ListBox x:Name="PriorityList"
                             BorderThickness="0"
                             Background="Transparent"
                             MaxHeight="120"
                             DisplayMemberPath="DisplayName"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                    <Button Content="▲" ToolTip="Raise priority" Click="OnMoveUpClick"
                            Style="{StaticResource AccentButtonStyle}" Margin="0,0,0,4"/>
                    <Button Content="▼" ToolTip="Lower priority" Click="OnMoveDownClick"
                            Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </Grid>
        </StackPanel>
        <CheckBox Content="Blacklist selected games (mine everything except these)"
                  IsChecked="{Binding IsBlacklistMode, ElementName=Root, Mode=TwoWay}"
                  Style="{StaticResource ModernCheckBoxStyle}"
                  Margin="0,0,0,8"/>
        <Button Content="{Binding ClearButtonText, ElementName=Root}"
                Style="{StaticResource AccentButtonStyle}"
                HorizontalAlignment="Left"
                Click="OnClearClick"
                Margin="{Binding ClearButtonMargin, ElementName=Root}"/>
    </StackPanel>
</UserControl>