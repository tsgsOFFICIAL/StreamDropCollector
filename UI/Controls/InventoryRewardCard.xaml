<UserControl x:Class="UI.Controls.InventoryRewardCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             xmlns:models="clr-namespace:UI.Models"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="320">

    <Border Background="{DynamicResource BorderBrush}"
            CornerRadius="8"
            Margin="0,0,0,8"
            Padding="12">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCurrentReward}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}"/>
                        <Setter Property="BorderThickness" Value="1.69"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:RoundedImage SourceUrl="{Binding ImageUrl}"
                                   ImageWidth="50" ImageHeight="50" CornerRadius="6"/>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"/>

                <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold">
                    <Run Text="{Binding ProgressMinutes, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding RequiredMinutes, Mode=OneWay}"/>
                    <Run Text=" min"/>
                </TextBlock>

                <ProgressBar Value="{Binding ProgressMinutes}"
                             Maximum="{Binding RequiredMinutes}"
                             Height="8"
                             Margin="0,8,0,0"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="#333333"/>
            </StackPanel>

            <controls:StatusBadge Grid.Column="2"
                                  BadgeText="CLAIMED"
                                  Variant="{x:Static models:StatusBadgeVariant.Claimed}"
                                  Margin="10,0,0,0"
                                  Visibility="{Binding IsClaimed, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <controls:StatusBadge Grid.Column="2"
                                  BadgeText="WATCHING"
                                  Variant="{x:Static models:StatusBadgeVariant.Watching}"
                                  Margin="10,0,0,0"
                                  Visibility="{Binding IsCurrentReward, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Border>
</UserControl>