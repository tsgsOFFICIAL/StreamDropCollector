<UserControl x:Class="UI.Controls.StatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:UI.Models"
             mc:Ignorable="d"
             d:DesignHeight="24" d:DesignWidth="80"
             x:Name="Root">

    <Border CornerRadius="6" Padding="8,4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SecondaryAccentBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Variant, ElementName=Root}" Value="{x:Static models:StatusBadgeVariant.Claimed}">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <TextBlock Text="{Binding BadgeText, ElementName=Root}"
                   FontWeight="Bold"
                   FontSize="10"
                   Foreground="{DynamicResource MainBackgroundBrush}"/>
    </Border>
</UserControl>