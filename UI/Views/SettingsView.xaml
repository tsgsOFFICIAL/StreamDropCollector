<UserControl x:Class="UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:Core.Enums;assembly=Core"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="800"
             Background="{DynamicResource MainBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageHeader}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,20,0">

                <controls:SettingsSectionCard Title="General">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Start with Windows"
                                  Margin="0,0,0,12"/>
                        <CheckBox IsChecked="{Binding MinimizeToTrayOnStartup, Mode=TwoWay}"
                                  IsEnabled="{Binding StartWithWindows}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Minimize to system tray on startup"
                                  Margin="0,0,0,12"/>
                        <CheckBox IsChecked="{Binding RunInBackground, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Keep running when window is closed"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Appearance">
                    <controls:SettingsLabeledRow Label="Theme" RowMargin="0,8,0,0">
                        <ComboBox Width="200"
                                  Style="{StaticResource NeonFlatComboBoxStyle}"
                                  SelectedValue="{Binding Theme, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </controls:SettingsLabeledRow>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Updates">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Check for updates automatically"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,20,0"/>
                            <ComboBox Width="240"
                                      Height="40"
                                      Style="{StaticResource NeonFlatComboBoxStyle}"
                                      SelectedValue="{Binding UpdateFrequency, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Every time the app starts" Tag="{x:Static enums:UpdateFrequency.OnLaunch}"/>
                                <ComboBoxItem Content="Daily" Tag="{x:Static enums:UpdateFrequency.Daily}"/>
                                <ComboBoxItem Content="Weekly" Tag="{x:Static enums:UpdateFrequency.Weekly}"/>
                                <ComboBoxItem Content="Never" Tag="{x:Static enums:UpdateFrequency.Never}"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="A new update is available, update now to experience the newest features!"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <Button Height="44"
                                MinWidth="240"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Update Now"
                                Foreground="Black"
                                FontWeight="Bold"
                                FontSize="13"
                                Click="OnUpdateButtonClick"
                                Margin="0,12,0,0"
                                Visibility="{Binding UpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Drops Behavior">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding AutoClaimRewards, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Auto-claim rewards when ready"
                                  Margin="0,0,0,12"/>
                        <controls:SettingsLabeledRow Label="Mining priority">
                            <ComboBox Width="260"
                                      Style="{StaticResource NeonFlatComboBoxStyle}"
                                      SelectedValue="{Binding MiningPriorityMode, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Availability + Progress" Tag="{x:Static enums:MiningPriorityMode.AvailabilityThenProgress}"/>
                                <ComboBoxItem Content="Ending Soonest" Tag="{x:Static enums:MiningPriorityMode.EndingSoonest}"/>
                                <ComboBoxItem Content="Least Time To Next Reward" Tag="{x:Static enums:MiningPriorityMode.LeastTimeToNextReward}"/>
                                <ComboBoxItem Content="Highest Completion" Tag="{x:Static enums:MiningPriorityMode.HighestCompletion}"/>
                            </ComboBox>
                        </controls:SettingsLabeledRow>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Game Filtering">
                    <StackPanel>
                        <TextBlock Text="If no games are selected, all games are allowed."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,12"/>

                        <controls:GameFilterPanel PlatformTitle="Twitch"
                                              WhitelistSummary="{Binding TwitchWhitelistSummary}"
                                              GameOptions="{Binding TwitchGameFilterOptions}"
                                              IsBlacklistMode="{Binding TwitchGameFilterBlacklistMode, Mode=TwoWay}"
                                              ClearButtonText="Clear Twitch whitelist"
                                              ClearButtonMargin="0,0,0,12"
                                              ClearClick="OnClearTwitchWhitelistClick"/>

                        <controls:GameFilterPanel PlatformTitle="Kick"
                                                  WhitelistSummary="{Binding KickWhitelistSummary}"
                                                  GameOptions="{Binding KickGameFilterOptions}"
                                                  IsBlacklistMode="{Binding KickGameFilterBlacklistMode, Mode=TwoWay}"
                                                  ClearButtonText="Clear Kick whitelist"
                                                  ClearClick="OnClearKickWhitelistClick"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Notifications">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding NotifyOnReadyToClaim, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Drop ready to claim (only if auto-claim is off)"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding AutoClaimRewards, Converter={StaticResource InverseBooleanConverter}}"/>
                        <CheckBox IsChecked="{Binding NotifyOnAutoClaimed, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Drop successfully auto-claimed (only if auto-claim is on)"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding AutoClaimRewards}"/>
                        <CheckBox IsChecked="{Binding NotifyOnNewUpdateAvailable, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="New update is available"
                                  Margin="0,0,0,12"
                                  IsEnabled="{Binding IsUpdateNotificationEnabled}"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Logs">
                    <StackPanel>
                        <TextBlock Text="Open the folder containing diagnostic logs for support tickets."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13"
                                   Margin="0,0,0,12"/>

                        <Border Style="{StaticResource InsetPanelBorder}" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding VerboseDebugLogging, Mode=TwoWay}"
                                          Style="{StaticResource ModernCheckBoxStyle}"
                                          Content="Verbose debug logging"
                                          Margin="0,0,0,6"/>
                                <TextBlock Text="Adds detailed miner + reward percentage trace logs. Enable only while troubleshooting."
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="32,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Open Logs Folder"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnOpenLogsFolderClick"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard Title="Accounts" IsDanger="True">
                    <StackPanel>
                        <TextBlock Text="DANGER ZONE"
                                   Foreground="#FF5555"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4"/>
                        <TextBlock Text="Permanently delete ALL logged-in accounts from this device"
                                   Foreground="#FFAAAA"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="Remove ALL Accounts"
                                Style="{StaticResource DangerButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnRemoveAllAccountsButtonClick"/>
                    </StackPanel>
                </controls:SettingsSectionCard>

                <controls:SettingsSectionCard SectionMargin="0" SectionOpacity="0.5">
                    <StackPanel>
                        <TextBlock Text="Your ideas could be here! (coming soon)"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Drop your suggestions, to have them implemented here"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="13"/>
                    </StackPanel>
                </controls:SettingsSectionCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>