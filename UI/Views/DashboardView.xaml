<UserControl x:Class="UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MainBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard" Style="{StaticResource PageHeader}"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <controls:MinerStatusCard Grid.Column="0" Margin="0,0,20,0"
                                      Status="{Binding MinerStatus}"
                                      Details="{Binding Summary}"/>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Accounts" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16"/>
                    <TextBlock Text="Every account mines in parallel, each with its own isolated login."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,12"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Twitch account" Style="{StaticResource TwitchButtonStyle}" Width="160" Height="36" Margin="0,0,10,0"
                                Click="OnAddTwitchAccountClick"/>
                        <Button Content="Add Kick account" Style="{StaticResource KickButtonStyle}" Width="160" Height="36"
                                Click="OnAddKickAccountClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:AccountCard/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
