<Window x:Class="UI.Views.AccountSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:enums="clr-namespace:Core.Enums;assembly=Core"
        Title="Account Settings"
        Width="560" Height="680"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageHeader}" FontSize="22"/>
            <TextBlock Text="Settings left on 'Use global' follow the main Settings page. Overrides apply to this account only."
                       Style="{StaticResource BodyText}" FontSize="12" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Auto-claim rewards" Style="{StaticResource SettingsSectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="UseGlobalAutoClaim" Content="Use global setting"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AutoClaimBox" Content="Auto-claim rewards when ready"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  IsEnabled="{Binding IsChecked, ElementName=UseGlobalAutoClaim, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Border>

                <Border x:Name="LevelFarmingCard" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Kick level farming" Style="{StaticResource SettingsSectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="UseGlobalLevelFarming" Content="Use global setting"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="LevelFarmingBox" Content="Watch a top streamer when no Kick drops are available"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  IsEnabled="{Binding IsChecked, ElementName=UseGlobalLevelFarming, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Mining priority" Style="{StaticResource SettingsSectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="UseGlobalPriority" Content="Use global setting"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="PriorityBox" Width="260" HorizontalAlignment="Left"
                                  Style="{StaticResource NeonFlatComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  IsEnabled="{Binding IsChecked, ElementName=UseGlobalPriority, Converter={StaticResource InverseBooleanConverter}}">
                            <ComboBoxItem Content="Availability + Progress" Tag="{x:Static enums:MiningPriorityMode.AvailabilityThenProgress}"/>
                            <ComboBoxItem Content="Ending Soonest" Tag="{x:Static enums:MiningPriorityMode.EndingSoonest}"/>
                            <ComboBoxItem Content="Least Time To Next Reward" Tag="{x:Static enums:MiningPriorityMode.LeastTimeToNextReward}"/>
                            <ComboBoxItem Content="Highest Completion" Tag="{x:Static enums:MiningPriorityMode.HighestCompletion}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="Game filtering" Style="{StaticResource SettingsSectionTitle}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="UseGlobalFilter" Content="Use global filter"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=UseGlobalFilter, Converter={StaticResource InverseBooleanConverter}}">
                            <TextBlock x:Name="FilterHint"
                                       Text="If no games are selected, all games are allowed."
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource InsetPanelBorder}" Margin="0,0,0,8">
                                <ItemsControl x:Name="GameList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding DisplayName}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      Style="{StaticResource ModernCheckBoxStyle}"
                                                      Margin="0,4,0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <CheckBox x:Name="BlacklistBox"
                                      Content="Blacklist selected games (mine everything except these)"
                                      Style="{StaticResource ModernCheckBoxStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Width="100" Height="36" Padding="0"
                    Margin="0,0,10,0" IsCancel="True" Click="OnCancelClick"/>
            <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Width="100" Height="36" Padding="0"
                    IsDefault="True" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>