<UserControl x:Class="UI.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:UI.Controls"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900"
             Background="{DynamicResource MainBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Help &amp; Support" Style="{StaticResource PageHeader}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel HorizontalAlignment="Stretch" Margin="0,0,20,0">

                <controls:HelpSectionCard Title="Getting Started">
                    <TextBlock Style="{StaticResource BodyText}">
                        <Run Text="1. Log in to your Twitch &amp; Kick accounts to enable drops tracking." Foreground="{DynamicResource AccentBrush}"/><LineBreak/>
                        <Run Text="2. Head to the Dashboard to watch your miner status and campaign progress in real time." Foreground="{DynamicResource TextMutedBrush}"/><LineBreak/>
                        <Run Text="3. Use the sidebar to switch between Inventory, Settings, and this Help page." Foreground="{DynamicResource TextMutedBrush}"/>
                    </TextBlock>
                </controls:HelpSectionCard>

                <controls:HelpSectionCard Title="Inventory Tracking">
                    <TextBlock Style="{StaticResource BodyText}">
                        All active campaigns and collected drops are displayed here with live progress per streamer.<LineBreak/>
                        Make sure your accounts are linked - rewards update automatically when claimed.
                    </TextBlock>
                </controls:HelpSectionCard>

                <controls:HelpSectionCard Title="Settings">
                    <TextBlock Style="{StaticResource BodyText}">
                        Customize auto-claim, notifications, theme, and more.<LineBreak/>
                        All changes are saved instantly - no &quot;Apply&quot; button needed.
                    </TextBlock>
                </controls:HelpSectionCard>

                <controls:HelpSectionCard Title="Support &amp; Community" SectionMargin="0">
                    <StackPanel>
                        <TextBlock FontSize="15"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,16"
                                   TextWrapping="Wrap">
                            Found a bug? Need help? Want to flex your drops?<LineBreak/>
                            Join the community - we're all farmers here.
                        </TextBlock>

                        <controls:ExternalLinkRow IconSource="/Assets/discord.png"
                                                  LinkText="Discord Community"
                                                  NavigateUri="https://discord.gg/Cddu5aJ"
                                                  RowMargin="0,0,0,12"/>

                        <controls:ExternalLinkRow IconSource="/Assets/github.png"
                                                  LinkText="GitHub Repository"
                                                  NavigateUri="https://github.com/tsgsOFFICIAL/StreamDropCollector"/>
                    </StackPanel>
                </controls:HelpSectionCard>

                <TextBlock Text="Made with rage, caffeine, and zero sleep by tsgsOFFICIAL"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,60,0,0"
                           FontStyle="Italic"/>

                <controls:HelpDonationCard/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>